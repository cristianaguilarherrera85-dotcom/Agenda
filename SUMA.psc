//Realizar algoritmo que pida dos números enteros y obtenga la suma de ellos, mostrar resultado en pantalla//
Algoritmo SUMA
	Definir num1, num2 Como Entero
	Escribir "Ingrese un número: "
	Leer num1
	Escribir "Ingrese otro número: "
	Leer num2
	Escribir "La suma es: ", num1+num2
	
	
	
FinAlgoritmo
