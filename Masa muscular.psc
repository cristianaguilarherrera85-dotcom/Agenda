Algoritmo sin_titulo
	Definir iden, nom Como Caracter
	Definir estatu, peso, IMC Como Real
	Escribir "Ingrese identificación: "
	Leer iden
	Escribir "Ingrese nombre del paciente: "
	Leer nom
	Escribir "Ingrese la estatura: "
	Leer estatu
	Escribir "Ingrese peso en kilos: "
	Leer peso
	IMC = peso /( estatu * estatu)
	Imprimir"***********************************"
	Escribir         "Datos del Paciente"
	Imprimir"***********************************"
	Imprimir "Su indentifiación es: ", iden
	Imprimir "Su nombre es: ", nom
	Imprimir "Su estatura es: ",estatu
	Imprimir "Su peso en kilos es: ",peso
	Imprimir"***********************************"
	Escribir         "Indice IMC"
	Imprimir"***********************************"
	Imprimir "Su indice IMC es: ", IMC
	
 

	
FinAlgoritmo
